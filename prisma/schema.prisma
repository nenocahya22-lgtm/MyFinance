datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SyncGroup {
  code         String   @id
  jwtSecret    String
  transactions String
  buckets      String
  accounts     String
  debtData     String?
  budgetConfig String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  members      FamilyMember[]
}

model FamilyMember {
  id        Int      @id @default(autoincrement())
  code      String
  userId    String
  role      String   @default("ANGGOTA")
  isOnline  Boolean  @default(false)
  lastSeen  DateTime @default(now())
  joinedAt  DateTime @default(now())
  group     SyncGroup @relation(fields: [code], references: [code])
  @@unique([code, userId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  code        String
  action      String
  userId      String
  userRole    String
  description String
  metadata    String?
  timestamp   DateTime @default(now())
}

model BudgetAlert {
  id           Int      @id @default(autoincrement())
  code         String
  category     String
  budgetLimit  Float
  currentSpend Float
  alertSent    Boolean  @default(false)
  month        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}